{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "react-router dev --port 3011",
    "build": "react-router build && bun build src/server.ts --target=node --packages=external --outfile=build/server.mjs",
    "start": "node ./build/server.mjs",
    "lint": "eslint src tests scripts eslint.config.mjs vite.config.mts vitest.config.mts react-router.config.ts playwright.config.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots=all",
    "upstream": "node tests/e2e/upstream.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "partners": "node scripts/partner-logos.mjs",
    "shots": "node scripts/project-shots.mjs",
    "og:scene": "node scripts/og-scene.mjs",
    "e2e:peak": "GLASS_BACKDROP=peak playwright test visual.spec.ts a11y.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@react-router/node": "8.4.0",
    "@resvg/resvg-js": "2.6.2",
    "compression": "1.8.2",
    "gsap": "~3.15.0",
    "intl-messageformat": "12.1.4",
    "isbot": "5.2.2",
    "lenis": "~1.3.26",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-router": "8.4.0",
    "satori": "0.25.0",
    "sirv": "3.0.2",
    "three": "0.186.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "8.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/compression": "1.8.1",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "estree-util-value-to-estree": "3.5.0",
    "github-slugger": "2.0.0",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "mdast-util-to-string": "4.0.0",
    "rehype-highlight": "7.0.2",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "schema-dts": "^2.0.0",
    "sharp": "0.35.5",
    "typescript": "^5",
    "typescript-eslint": "8.70.0",
    "unist-util-mdx-define": "1.1.2",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
