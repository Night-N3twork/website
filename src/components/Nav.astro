---
import LangSwitcher from '@components/LangSwitcher.astro';
import {
	LOCALES,
	extractLocaleFromPath,
	pathFor,
	tFor
} from '@utils/i18n';

const locale =
	(Astro.locals as { locale?: typeof LOCALES[number] } | undefined)?.locale ??
	extractLocaleFromPath(Astro.url.pathname);
const t = tFor(locale);
---

<div
	class="fixed bg-mocha-mantle text-mocha-text rounded-md shadow-lg p-2 md:p-3 max-w-xl w-fit backdrop-blur-md border border-mocha-base top-2 left-0 right-0 mx-auto mb-2 flex items-center justify-center gap-2 md:gap-4 z-[1000] animate-fade-in"
>
	<a
		class="text-mocha-lavender hover:text-mocha-blue p-2 md:p-0 hover:scale-110 transition-all duration-300"
		href={pathFor(locale, '/')}
		title={t('nav.home')}
	>
		<span data-lucide="home" class="w-5 h-5 md:w-6 md:h-6"></span>
	</a>
	<a
		class="text-mocha-lavender hover:text-mocha-blue p-2 md:p-0 hover:scale-110 transition-all duration-300"
		href={pathFor(locale, '/projects')}
		title={t('nav.projects')}
	>
		<span data-lucide="code" class="w-5 h-5 md:w-6 md:h-6"></span>
	</a>
	<a
		class="text-mocha-lavender hover:text-mocha-blue p-2 md:p-0 hover:scale-110 transition-all duration-300"
		href={pathFor(locale, '/contributors')}
		title={t('nav.contributors')}
	>
		<span data-lucide="users" class="w-5 h-5 md:w-6 md:h-6"></span>
	</a>
	<a
		class="text-mocha-lavender hover:text-mocha-blue p-2 md:p-0 hover:scale-110 transition-all duration-300"
		href={pathFor(locale, '/supporters')}
		title={t('nav.supporters')}
	>
		<span data-lucide="heart" class="w-5 h-5 md:w-6 md:h-6"></span>
	</a>
	<a
		class="text-mocha-lavender hover:text-mocha-blue p-2 md:p-0 hover:scale-110 transition-all duration-300"
		href="https://uptime.night-x.com"
		title={t('nav.uptime')}
	>
		<span data-lucide="activity" class="w-5 h-5 md:w-6 md:h-6"></span>
	</a>
	<LangSwitcher />
</div>
