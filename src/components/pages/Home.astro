---
import Layout from '@layouts/Layout.astro';
import Overlay from '@components/Overlay.astro';
import Github from '@components/icons/Github.astro';
import Gitlab from '@components/icons/Gitlab.astro';
import Discord from '@components/icons/Discord.astro';
import Youtube from '@components/icons/Youtube.astro';
import Patreon from '@components/icons/Patreon.astro';
import {
	LOCALES,
	extractLocaleFromPath,
	tFor
} from '@utils/i18n';

const locale =
	(Astro.locals as { locale?: typeof LOCALES[number] } | undefined)?.locale ??
	extractLocaleFromPath(Astro.url.pathname);
const t = tFor(locale);

// Pre-resolve the strings that the inline script needs at runtime.
const memberCountFallback = t('home.memberCountFallback');
---

<Layout>
	<Overlay
		enableBg={false}
		customClasses="max-w-full md:max-w-5xl w-full px-4 xs:px-2"
	>
		<div class="flex flex-col md:flex-row gap-3 md:gap-4">
			<div
				class="flex flex-col gap-3 md:gap-4 flex-grow md:max-w-2xl w-full"
			>
				<Overlay
					customClasses="w-full flex items-center flex-col gap-3 md:gap-4 reveal"
					enableBg={true}
				>
					<div
						class="flex flex-col xs:flex-row items-center gap-4 md:gap-6 mb-2 md:mb-4 w-full"
					>
						<img
							src="/res/logo.png"
							alt={t('home.logoAlt')}
							class="w-16 xs:w-20 h-16 xs:h-20 rounded-xl flex-shrink-0"
						/>
						<div class="text-center xs:text-left">
							<h1 class="text-2xl xs:text-3xl font-bold">
								{t('home.orgName')}
							</h1>
						</div>
					</div>
					<p
						class="text-xs xs:text-sm text-night-text leading-relaxed"
					>
						{t('home.introBefore')}<span
							id="member-count"
							class="text-night-lavender font-semibold"
							data-fallback={memberCountFallback}
							>...</span
						>{t('home.introAfter')}
					</p>
				</Overlay>

				<Overlay
					customClasses="w-full flex flex-col gap-3 md:gap-4 reveal"
					data-delay="150"
					enableBg={true}
				>
					<h2
						class="text-base md:text-lg font-semibold mb-2 text-night-text"
					>
						{t('home.partnersHeading')}
					</h2>
					<div
						class="flex flex-col gap-2 md:gap-3 text-xs xs:text-sm text-night-text overflow-y-auto max-h-96 md:max-h-none pr-2"
					>
						<a
							href="https://titaniumnetwork.org"
							class="border border-night-surface0 hover:bg-night-base hover:border-night-mauve rounded-lg p-2 md:p-3 flex gap-3 transition-all duration-300 hover:translate-x-0.5"
						>
							<img
								src="/res/partners/tn.png"
								alt={t('home.partners.titanium.alt')}
								class="w-8 md:w-10 h-8 md:h-10 flex-shrink-0"
							/>
							<div
								class="flex flex-col items-start justify-center"
							>
								<h3
									class="font-semibold text-night-text hover:text-night-mauve transition-colors"
								>
									{t('home.partners.titanium.name')}
								</h3>
							</div>
						</a>
						<a
							href="https://nebulaservices.org"
							class="border border-night-surface0 hover:bg-night-base hover:border-night-lavender rounded-lg p-2 md:p-3 flex gap-3 transition-all duration-300 hover:translate-x-0.5"
						>
							<img
								src="/res/partners/nebula.png"
								alt={t('home.partners.nebula.alt')}
								class="w-8 md:w-10 h-8 md:h-10 flex-shrink-0"
							/>
							<div
								class="flex flex-col items-start justify-center"
							>
								<h3
									class="flex items-center gap-1.5 font-semibold text-night-text hover:text-night-lavender transition-colors"
								>
									{t('home.partners.nebula.name')}
									<span class="group/host relative inline-flex text-night-lavender">
										<span data-lucide="server" class="h-3.5 w-3.5"></span>
										<span class="invisible absolute bottom-full left-1/2 z-10 mb-2 w-max max-w-48 -translate-x-1/2 rounded-md border border-night-surface1 bg-night-mantle px-2 py-1 text-[10px] font-medium normal-case tracking-normal text-night-text opacity-0 shadow-lg transition-opacity group-hover/host:visible group-hover/host:opacity-100">
											{t('home.partners.hostedBadge')}
										</span>
									</span>
								</h3>
							</div>
						</a>
						<a
							href="https://terbiumon.top"
							class="border border-night-surface0 hover:bg-night-base hover:border-night-green rounded-lg p-2 md:p-3 flex gap-3 transition-all duration-300 hover:translate-x-0.5"
						>
							<img
								src="/res/partners/terbium.png"
								alt={t('home.partners.terbium.alt')}
								class="w-8 md:w-10 h-8 md:h-10 flex-shrink-0"
							/>
							<div
								class="flex flex-col items-start justify-center"
							>
								<h3
									class="flex items-center gap-1.5 font-semibold text-night-text hover:text-night-green transition-colors"
								>
									{t('home.partners.terbium.name')}
									<span class="group/host relative inline-flex text-night-green">
										<span data-lucide="server" class="h-3.5 w-3.5"></span>
										<span class="invisible absolute bottom-full left-1/2 z-10 mb-2 w-max max-w-48 -translate-x-1/2 rounded-md border border-night-surface1 bg-night-mantle px-2 py-1 text-[10px] font-medium normal-case tracking-normal text-night-text opacity-0 shadow-lg transition-opacity group-hover/host:visible group-hover/host:opacity-100">
											{t('home.partners.hostedBadge')}
										</span>
									</span>
								</h3>
							</div>
						</a>
						<a
							href="https://lunaron.top"
							class="border border-night-surface0 hover:bg-night-base hover:border-night-blue rounded-lg p-2 md:p-3 flex gap-3 transition-all duration-300 hover:translate-x-0.5"
						>
							<img
								src="/res/partners/lunar.png"
								alt={t('home.partners.lunar.alt')}
								class="w-8 md:w-10 h-8 md:h-10 flex-shrink-0"
							/>
							<div
								class="flex flex-col items-start justify-center"
							>
								<h3
									class="flex items-center gap-1.5 font-semibold text-night-text hover:text-night-blue transition-colors"
								>
									{t('home.partners.lunar.name')}
									<span class="group/host relative inline-flex text-night-blue">
										<span data-lucide="server" class="h-3.5 w-3.5"></span>
										<span class="invisible absolute bottom-full left-1/2 z-10 mb-2 w-max max-w-48 -translate-x-1/2 rounded-md border border-night-surface1 bg-night-mantle px-2 py-1 text-[10px] font-medium normal-case tracking-normal text-night-text opacity-0 shadow-lg transition-opacity group-hover/host:visible group-hover/host:opacity-100">
											{t('home.partners.hostedBadge')}
										</span>
									</span>
								</h3>
							</div>
						</a>
						<!--<a
							href="https://obsidiandevlabs.org"
							class="border border-night-surface0 hover:bg-night-base hover:border-night-mauve rounded-lg p-2 md:p-3 flex gap-3 transition-all duration-300 hover:translate-x-0.5"
						>
							<img
								src="/res/partners/obsidian.png"
								alt={t('home.partners.obsidian.alt')}
								class="w-8 md:w-10 h-8 md:h-10 flex-shrink-0"
							/>
							<div
								class="flex flex-col items-start justify-center"
							>
								<h3
									class="font-semibold text-night-text hover:text-night-mauve transition-colors"
								>
									{t('home.partners.obsidian.name')}
								</h3>
							</div>
						</a>-->
					</div>
				</Overlay>
			</div>

			<div class="flex flex-col gap-3 md:gap-4 w-full md:max-w-xs">
				<Overlay
					enableBg={true}
					customClasses="w-full flex flex-col gap-2 md:gap-3 reveal"
					data-delay="250"
				>
					<h2
						class="text-base md:text-lg font-semibold mb-2 text-night-text"
					>
						{t('home.accountsHeading')}
					</h2>
					<div
						class="grid grid-cols-2 md:grid-cols-1 gap-2 md:gap-3 text-xs md:text-sm"
					>
						<a
							class="text-night-subtext0 flex items-center gap-2 hover:text-night-lavender transition-all duration-300 hover:translate-x-0.5"
							href="https://github.com/Night-N3twork"
							><Github class="w-6 h-6 flex-shrink-0" /><span
								class="font-medium truncate"
								>{t('home.accounts.mainGithub')}</span
							></a
						>
						<a
							class="text-night-subtext0 flex items-center gap-2 hover:text-night-lavender transition-all duration-300 hover:translate-x-0.5"
							href="https://github.com/Lunar-Proxy"
							><Github class="w-6 h-6 flex-shrink-0" /><span
								class="font-medium truncate"
								>{t('home.accounts.lunarGithub')}</span
							></a
						>
						<!--<a
							class="text-night-subtext0 flex items-center gap-2 hover:text-night-lavender transition-all duration-300 hover:translate-x-0.5"
							href="https://github.com/Obsidian-Dev-Labs"
							><Github class="w-6 h-6 flex-shrink-0" /><span
								class="font-medium truncate"
								>{t('home.accounts.obsidianGithub')}</span
							></a
				>-->
						<a
							class="text-night-peach flex items-center gap-2 hover:text-night-yellow transition-all duration-300 hover:translate-x-0.5"
							href="https://gitlab.com/nightnetwork"
							><Gitlab class="w-6 h-6 flex-shrink-0" /><span
								class="font-medium truncate"
								>{t('home.accounts.mainGitlab')}</span
							></a
						>
						<a
							class="text-night-blue flex items-center gap-2 hover:text-night-sky transition-all duration-300 hover:translate-x-0.5"
							href="https://discord.night-x.com"
							><Discord class="w-6 h-6 flex-shrink-0" /><span
								class="font-medium truncate"
								>{t('home.accounts.nightDiscord')}</span
							></a
						>
						<a
							class="text-night-blue flex items-center gap-2 hover:text-night-sky transition-all duration-300 hover:translate-x-0.5"
							href="https://discord.gg/JS6u8KuXf7"
							><Discord class="w-6 h-6 flex-shrink-0" /><span
								class="font-medium truncate"
								>{t('home.accounts.lunarDiscord')}</span
							></a
						>
						<a
							class="text-night-red flex items-center gap-2 hover:text-night-flamingo transition-all duration-300 hover:translate-x-0.5"
							href="https://www.youtube.com/@NightNetworkOffical"
							><Youtube class="w-6 h-6 flex-shrink-0" /><span
								class="font-medium truncate"
								>{t('home.accounts.youtube')}</span
							></a
						>
					</div>
				</Overlay>
				<Overlay
					enableBg={true}
					customClasses="w-full flex flex-col gap-2 md:gap-3 reveal"
					data-delay="350"
				>
					<h2 class="text-base md:text-lg font-semibold mb-2 text-night-text">
						{t('home.sponsorship.heading')}
					</h2>
					<p class="text-xs md:text-sm text-night-subtext0">
						{t('home.sponsorship.description')}
					</p>
					<div class="grid grid-cols-2 gap-2 md:grid-cols-1 md:gap-3 text-xs md:text-sm">
						<a
							class="flex items-center gap-2 text-night-text transition-all duration-300 hover:translate-x-0.5 hover:text-night-lavender"
							href="https://www.patreon.com/c/nightNetwork"
						>
							<Patreon class="w-6 h-6 flex-shrink-0" />
							<span class="font-medium truncate">{t('home.sponsorship.patreon')}</span>
						</a>
						<a
							class="flex items-center gap-2 text-night-yellow transition-all duration-300 hover:translate-x-0.5 hover:text-night-peach"
							href="https://ko-fi.com/nightnetwork"
						>
							<span data-lucide="coffee" class="w-6 h-6 flex-shrink-0"></span>
							<span class="font-medium truncate">{t('home.sponsorship.kofi')}</span>
						</a>
					</div>
				</Overlay>
			</div>
		</div>
	</Overlay>
</Layout>

<script>
	async function loadMemberCount() {
		const el = document.getElementById('member-count');
		if (!el) return;
		const fallback = el.dataset.fallback ?? 'thousands of';
		const lang = document.documentElement.lang || 'en';
		try {
			const res = await fetch('/api/stats');
			if (!res.ok) throw new Error(res.statusText);
			const data = await res.json();
			if (data.memberCount != null) {
				el.textContent = new Intl.NumberFormat(lang).format(
					data.memberCount
				);
			}
		} catch {
			el.textContent = fallback;
		}
	}

	loadMemberCount();
	document.addEventListener('astro:page-load', loadMemberCount);
	document.addEventListener('astro:after-swap', loadMemberCount);
</script>
