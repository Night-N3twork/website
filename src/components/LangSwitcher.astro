---
import {
	LOCALES,
	DEFAULT_LOCALE,
	extractLocaleFromPath,
	stripLocale,
	pathFor,
	tFor,
	LOCALE_COOKIE,
	LOCALE_COOKIE_MAX_AGE
} from '@utils/i18n';

const activeLocale =
	(Astro.locals as { locale?: typeof LOCALES[number] } | undefined)?.locale ??
	extractLocaleFromPath(Astro.url.pathname);
const t = tFor(activeLocale);
const canonical = stripLocale(Astro.url.pathname);

const labelKey = {
	en: 'language.english',
	es: 'language.spanish',
	fr: 'language.french',
	ja: 'language.japanese'
} as const;
---

<div class="relative inline-block" data-langswitcher>
	<button
		type="button"
		class="text-mocha-lavender hover:text-mocha-blue p-2 md:p-0 hover:scale-110 transition-all duration-300 cursor-pointer flex items-center"
		title={t('nav.language')}
		aria-haspopup="menu"
		aria-expanded="false"
		data-langswitcher-toggle
	>
		<span data-lucide="globe" class="w-5 h-5 md:w-6 md:h-6"></span>
	</button>
	<div
		class="hidden absolute right-0 mt-2 min-w-[140px] bg-mocha-mantle border border-mocha-surface0 rounded-lg shadow-lg backdrop-blur-md z-[1100] py-1"
		role="menu"
		data-langswitcher-menu
	>
		{
			LOCALES.map(l => (
				<a
					href={pathFor(l, canonical)}
					role="menuitem"
					data-locale={l}
					class:list={[
						'block px-3 py-2 text-xs md:text-sm transition-colors',
						l === activeLocale
							? 'text-mocha-lavender font-semibold bg-mocha-base'
							: 'text-mocha-text hover:text-mocha-lavender hover:bg-mocha-base'
					]}
				>
					{tFor(l)(labelKey[l])}
				</a>
			))
		}
	</div>
</div>

<script
	is:inline
	define:vars={{
		LOCALE_COOKIE,
		LOCALE_COOKIE_MAX_AGE
	}}
>
	// Event delegation: a single set of document-level listeners drives every
	// LangSwitcher on the page, including ones that arrive via Astro's
	// ClientRouter view transitions. Idempotent — installing twice is a no-op
	// because we tag the document on first install.
	(function () {
		if (document.documentElement.dataset.langswitcherInstalled === '1')
			return;
		document.documentElement.dataset.langswitcherInstalled = '1';

		function setOpen(root, open) {
			const toggle = root.querySelector('[data-langswitcher-toggle]');
			const menu = root.querySelector('[data-langswitcher-menu]');
			if (!toggle || !menu) return;
			if (open) {
				menu.classList.remove('hidden');
				toggle.setAttribute('aria-expanded', 'true');
			} else {
				menu.classList.add('hidden');
				toggle.setAttribute('aria-expanded', 'false');
			}
		}

		function closeAll(except) {
			document
				.querySelectorAll('[data-langswitcher]')
				.forEach(r => {
					if (r !== except) setOpen(r, false);
				});
		}

		document.addEventListener('click', e => {
			const target = e.target;
			if (!(target instanceof Element)) return;

			// Click on a locale link inside the menu — set the cookie so the
			// root-redirect middleware honours the user's explicit choice on
			// subsequent visits. Don't preventDefault — the link still
			// navigates normally to the new locale URL.
			const localeLink = target.closest(
				'[data-langswitcher-menu] a[data-locale]'
			);
			if (localeLink) {
				const loc = localeLink.getAttribute('data-locale');
				if (loc) {
					document.cookie =
						LOCALE_COOKIE +
						'=' +
						encodeURIComponent(loc) +
						'; Max-Age=' +
						LOCALE_COOKIE_MAX_AGE +
						'; Path=/; SameSite=Lax';
				}
				return;
			}

			// Click on the toggle button — open this switcher, close any others.
			const toggle = target.closest('[data-langswitcher-toggle]');
			if (toggle) {
				const root = toggle.closest('[data-langswitcher]');
				if (!root) return;
				const menu = root.querySelector('[data-langswitcher-menu]');
				const isHidden = menu?.classList.contains('hidden');
				closeAll(root);
				setOpen(root, !!isHidden);
				return;
			}

			// Click anywhere else (outside any switcher) — close all switchers.
			if (!target.closest('[data-langswitcher]')) {
				closeAll(null);
			}
		});

		// Close on Escape for keyboard users.
		document.addEventListener('keydown', e => {
			if (e.key === 'Escape') closeAll(null);
		});
	})();
</script>
